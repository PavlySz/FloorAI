[Unit]
Description=FloorAI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/floorai
EnvironmentFile=/home/ubuntu/floorai/keys.env
ExecStart=/home/ubuntu/floorai/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
